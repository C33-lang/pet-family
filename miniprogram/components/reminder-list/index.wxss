.reminder-panel {
  position: relative;
  min-height: 480rpx;
  border-radius: 0 0 12rpx 12rpx;
  background: #ffffff;
}

.reminder-scroll {
  height: 720rpx;
}

/* ---------- 待办汇总 ---------- */
.summary-card {
  margin: 26rpx;
  padding: 32rpx 30rpx;
  border-radius: 16rpx;
  background: linear-gradient(135deg, #fff4ea 0%, #ffe9d6 100%);
}

.summary-label {
  font-size: 24rpx;
  color: #a8825f;
}

.summary-count {
  margin-top: 10rpx;
  font-size: 60rpx;
  font-weight: 600;
  color: #2f2a27;
  line-height: 1.1;
}

.summary-sub {
  margin-top: 12rpx;
  font-size: 23rpx;
  color: #a8825f;
}

/* ---------- 列表 ---------- */
.reminder-item {
  position: relative;
  display: flex;
  align-items: flex-start;
  margin: 0 26rpx;
  padding: 28rpx 0;
  border-bottom: 1rpx solid #f2e8e1;
}

.reminder-icon {
  display: flex;
  width: 72rpx;
  height: 72rpx;
  flex: none;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #fff2e8;
  font-size: 34rpx;
}

.reminder-main {
  min-width: 0;
  flex: 1;
  margin-left: 22rpx;
}

.reminder-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.reminder-name {
  overflow: hidden;
  max-width: 340rpx;
  font-size: 28rpx;
  font-weight: 500;
  color: #2f2a27;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.reminder-status {
  font-size: 26rpx;
  font-weight: 600;
}

.reminder-meta {
  display: flex;
  align-items: center;
  margin-top: 10rpx;
  font-size: 23rpx;
  color: #a9a09a;
}

.reminder-cycle {
  margin-left: 16rpx;
  color: #c09272;
}

/* ---------- 状态配色：逾期红 / 今天橙 / 7 天内浅橙 / 其余灰 ---------- */
.level-overdue {
  color: #e64340;
}

.level-today {
  color: #ff8c42;
}

.level-soon {
  color: #d98b3f;
}

.level-normal {
  color: #a9a09a;
}

.deleting-mask {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 12rpx;
  background: rgba(255, 255, 255, 0.75);
  font-size: 24rpx;
  color: #9a938d;
}

.load-more {
  padding: 28rpx 0;
  font-size: 23rpx;
  color: #b8b0aa;
  text-align: center;
}

.retry-more {
  color: #ff8c42;
}

/* ---------- 骨架屏 ---------- */
.skeleton-wrap {
  padding: 26rpx;
}

.skeleton-summary {
  height: 220rpx;
  border-radius: 16rpx;
  background: #f6efe9;
}

.skeleton-row {
  height: 132rpx;
  margin-top: 20rpx;
  border-radius: 12rpx;
  background: #faf4ef;
}

/* ---------- 状态 ---------- */
.state-box {
  display: flex;
  min-height: 480rpx;
  align-items: center;
  flex-direction: column;
  justify-content: center;
  padding: 0 40rpx;
}

.state-icon {
  font-size: 76rpx;
}

.state-text {
  margin-top: 22rpx;
  font-size: 26rpx;
  color: #9a938d;
  text-align: center;
}

.retry-button {
  min-width: 220rpx;
  height: 72rpx;
  margin-top: 30rpx;
  border: 2rpx solid #ffd7b8;
  border-radius: 36rpx;
  background: #ffffff;
  font-size: 26rpx;
  line-height: 68rpx;
  color: #ff8c42;
}

.retry-button::after {
  border: none;
}

/* ---------- 悬浮按钮 ---------- */
.add-button {
  position: fixed;
  right: 38rpx;
  bottom: 48rpx;
  z-index: 5;
  width: 104rpx;
  height: 104rpx;
  padding: 0;
  border-radius: 50%;
  background: #ff8c42;
  box-shadow: 0 12rpx 28rpx rgba(255, 140, 66, 0.32);
  font-size: 56rpx;
  line-height: 104rpx;
  color: #ffffff;
}

.add-button::after {
  border: 0;
}

/* ---------- 详情弹层 ---------- */
.sheet-mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 20;
  background: rgba(0, 0, 0, 0.35);
}

.sheet {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 21;
  padding: 36rpx 36rpx 48rpx;
  border-radius: 24rpx 24rpx 0 0;
  background: #ffffff;
}

.sheet-head {
  display: flex;
  align-items: center;
  padding-bottom: 24rpx;
  border-bottom: 1rpx solid #f2e8e1;
}

.sheet-icon {
  font-size: 40rpx;
}

.sheet-title {
  flex: 1;
  margin-left: 16rpx;
  font-size: 32rpx;
  font-weight: 600;
  color: #2f2a27;
}

.sheet-badge {
  font-size: 26rpx;
  font-weight: 600;
}

.sheet-row {
  display: flex;
  align-items: flex-start;
  margin-top: 22rpx;
}

.sheet-label {
  width: 140rpx;
  flex: none;
  font-size: 26rpx;
  color: #a9a09a;
}

.sheet-value {
  flex: 1;
  font-size: 26rpx;
  color: #3b332f;
  word-break: break-all;
}

.sheet-hint {
  margin-top: 26rpx;
  font-size: 22rpx;
  color: #b8b0aa;
  text-align: center;
}

.sheet-actions {
  display: flex;
  margin-top: 26rpx;
}

.sheet-secondary,
.sheet-primary {
  height: 84rpx;
  flex: 1;
  border-radius: 12rpx;
  font-size: 28rpx;
  line-height: 84rpx;
}

.sheet-secondary {
  margin-right: 20rpx;
  background: #f7f1ec;
  color: #6f625a;
}

.sheet-primary {
  background: #ff8c42;
  color: #ffffff;
}

.sheet-secondary::after,
.sheet-primary::after {
  border: 0;
}
