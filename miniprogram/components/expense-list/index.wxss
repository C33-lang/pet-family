.expense-panel {
  position: relative;
  min-height: 480rpx;
  border-radius: 0 0 12rpx 12rpx;
  background: #ffffff;
}

.expense-scroll {
  height: 720rpx;
}

/* ---------- 月度汇总 ---------- */
.summary-card {
  margin: 26rpx;
  padding: 32rpx 30rpx;
  border-radius: 16rpx;
  background: linear-gradient(135deg, #fff4ea 0%, #ffe9d6 100%);
}

.summary-label {
  font-size: 24rpx;
  color: #a8825f;
}

.summary-amount {
  margin-top: 10rpx;
  font-size: 60rpx;
  font-weight: 600;
  color: #2f2a27;
  line-height: 1.1;
}

.summary-sub {
  margin-top: 12rpx;
  font-size: 23rpx;
  color: #a8825f;
}

.category-bars {
  margin-top: 26rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid rgba(168, 130, 95, 0.18);
}

.category-row {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.category-row:last-child {
  margin-bottom: 0;
}

.category-icon {
  width: 36rpx;
  font-size: 26rpx;
}

.category-name {
  width: 128rpx;
  font-size: 24rpx;
  color: #6b5b4d;
}

.category-track {
  height: 12rpx;
  flex: 1;
  overflow: hidden;
  border-radius: 6rpx;
  background: rgba(255, 255, 255, 0.75);
}

.category-fill {
  height: 100%;
  border-radius: 6rpx;
  background: #ff8c42;
}

.category-amount {
  width: 140rpx;
  font-size: 24rpx;
  color: #6b5b4d;
  text-align: right;
}

/* ---------- 列表 ---------- */
.expense-item {
  position: relative;
  display: flex;
  align-items: flex-start;
  margin: 0 26rpx;
  padding: 28rpx 0;
  border-bottom: 1rpx solid #f2e8e1;
}

.expense-icon {
  display: flex;
  width: 72rpx;
  height: 72rpx;
  flex: none;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #fff2e8;
  font-size: 34rpx;
}

.expense-main {
  min-width: 0;
  flex: 1;
  margin-left: 22rpx;
}

.expense-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.expense-name {
  font-size: 28rpx;
  font-weight: 500;
  color: #2f2a27;
}

.expense-amount {
  font-size: 30rpx;
  font-weight: 600;
  color: #e07b32;
}

.expense-remark {
  margin-top: 8rpx;
  overflow: hidden;
  font-size: 25rpx;
  color: #6b625c;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.expense-meta {
  display: flex;
  align-items: center;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #a9a09a;
}

.expense-shared {
  margin-left: 16rpx;
  color: #c09272;
}

.deleting-mask {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 12rpx;
  background: rgba(255, 255, 255, 0.75);
  font-size: 24rpx;
  color: #9a938d;
}

.load-more {
  padding: 28rpx 0;
  font-size: 23rpx;
  color: #b8b0aa;
  text-align: center;
}

.retry-more {
  color: #ff8c42;
}

/* ---------- 骨架屏 ---------- */
.skeleton-wrap {
  padding: 26rpx;
}

.skeleton-summary {
  height: 240rpx;
  border-radius: 16rpx;
  background: #f6efe9;
}

.skeleton-row {
  height: 132rpx;
  margin-top: 20rpx;
  border-radius: 12rpx;
  background: #faf4ef;
}

/* ---------- 状态 ---------- */
.state-box {
  display: flex;
  min-height: 480rpx;
  align-items: center;
  flex-direction: column;
  justify-content: center;
  padding: 0 40rpx;
}

.state-icon {
  font-size: 76rpx;
}

.state-text {
  margin-top: 22rpx;
  font-size: 26rpx;
  color: #9a938d;
  text-align: center;
}

.retry-button {
  min-width: 220rpx;
  height: 72rpx;
  margin-top: 30rpx;
  border: 2rpx solid #ffd7b8;
  border-radius: 36rpx;
  background: #ffffff;
  font-size: 26rpx;
  line-height: 68rpx;
  color: #ff8c42;
}

.retry-button::after {
  border: none;
}

/* ---------- 悬浮按钮 ---------- */
.add-button {
  position: fixed;
  right: 38rpx;
  bottom: 48rpx;
  z-index: 5;
  width: 104rpx;
  height: 104rpx;
  padding: 0;
  border-radius: 50%;
  background: #ff8c42;
  box-shadow: 0 12rpx 28rpx rgba(255, 140, 66, 0.32);
  font-size: 56rpx;
  line-height: 104rpx;
  color: #ffffff;
}

.add-button::after {
  border: 0;
}
