page {
  background: #fffaf6;
  color: #2f2a27;
}

.page {
  min-height: 100vh;
  padding: 28rpx 28rpx 60rpx;
  box-sizing: border-box;
}

.form-card {
  margin-bottom: 24rpx;
  padding: 30rpx 26rpx;
  border-radius: 12rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 28rpx rgba(109, 76, 54, 0.06);
}

.section-title,
.field-label {
  color: #3b332f;
  font-size: 28rpx;
  font-weight: 600;
}

.required {
  color: #e64340;
}

.type-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 18rpx;
  margin-top: 26rpx;
}

.type-item {
  display: flex;
  height: 128rpx;
  align-items: center;
  flex-direction: column;
  justify-content: center;
  border: 2rpx solid transparent;
  border-radius: 12rpx;
  background: #fff7f1;
}

.type-item.selected {
  border-color: #ff8c42;
  background: #fff0e5;
  box-shadow: 0 4rpx 14rpx rgba(255, 140, 66, 0.16);
}

.type-icon {
  font-size: 38rpx;
}

.type-label {
  margin-top: 10rpx;
  color: #6f625a;
  font-size: 24rpx;
}

.type-item.selected .type-label {
  color: #ff8c42;
  font-weight: 600;
}

.field-row {
  display: flex;
  min-height: 70rpx;
  align-items: center;
  justify-content: space-between;
}

.picker-value {
  color: #6f625a;
  font-size: 27rpx;
}

.arrow {
  margin-left: 10rpx;
  color: #b7ada7;
  font-size: 34rpx;
}

.divider {
  height: 1rpx;
  margin: 18rpx 0;
  background: #f0e4dc;
}

.weight-input-wrap {
  display: flex;
  align-items: center;
}

.weight-input {
  width: 180rpx;
  height: 66rpx;
  padding: 0 18rpx;
  border: 1rpx solid #eaded6;
  border-radius: 12rpx;
  background: #fffaf6;
  font-size: 28rpx;
  text-align: right;
}

.weight-unit {
  width: 48rpx;
  margin-left: 12rpx;
  color: #6f625a;
  font-size: 26rpx;
}

.field-hint {
  margin-top: 14rpx;
  color: #aaa09a;
  font-size: 22rpx;
  text-align: right;
}

.content-input {
  width: 100%;
  height: 220rpx;
  margin-top: 22rpx;
  padding: 22rpx;
  border-radius: 12rpx;
  background: #fffaf6;
  box-sizing: border-box;
  color: #3b332f;
  font-size: 27rpx;
}

.count-text {
  margin-top: 12rpx;
  color: #b1a7a1;
  font-size: 22rpx;
  text-align: right;
}

.submit-button {
  height: 92rpx;
  margin-top: 36rpx;
  border-radius: 12rpx;
  background: #ff8c42;
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 92rpx;
}

.submit-button[disabled] {
  background: #e5d8cf;
  color: #ffffff;
}

.submit-button::after {
  border: 0;
}
