page {
  background: #fffaf6;
  color: #2f2a27;
}

.page {
  min-height: 100vh;
  padding: 28rpx 28rpx 60rpx;
  box-sizing: border-box;
}

.form-card {
  margin-bottom: 24rpx;
  padding: 30rpx 26rpx;
  border-radius: 12rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 28rpx rgba(109, 76, 54, 0.06);
}

.section-title,
.field-label {
  color: #3b332f;
  font-size: 28rpx;
  font-weight: 600;
}

.required {
  color: #e64340;
}

/* ---------- 分类 ---------- */
.type-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 18rpx;
  margin-top: 26rpx;
}

.type-item {
  display: flex;
  height: 128rpx;
  align-items: center;
  flex-direction: column;
  justify-content: center;
  border: 2rpx solid transparent;
  border-radius: 12rpx;
  background: #fff7f1;
}

.type-item.selected {
  border-color: #ff8c42;
  background: #fff0e5;
  box-shadow: 0 4rpx 14rpx rgba(255, 140, 66, 0.16);
}

.type-icon {
  font-size: 38rpx;
}

.type-label {
  margin-top: 10rpx;
  color: #6f625a;
  font-size: 24rpx;
}

.type-item.selected .type-label {
  color: #ff8c42;
  font-weight: 600;
}

/* ---------- 名称 ---------- */
.text-input {
  height: 78rpx;
  margin-top: 18rpx;
  padding-bottom: 14rpx;
  border-bottom: 2rpx solid #f0e4dc;
  color: #2f2a27;
  font-size: 30rpx;
}

/* ---------- 周期 / 日期 ---------- */
.field-row {
  display: flex;
  min-height: 70rpx;
  align-items: center;
  justify-content: space-between;
}

.field-row.divided {
  margin-top: 18rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid #f4ece6;
}

.picker-value {
  color: #6f625a;
  font-size: 27rpx;
}

.arrow {
  margin-left: 10rpx;
  color: #b7ada7;
  font-size: 34rpx;
}

/* ---------- 关联宠物 ---------- */
.pet-chips {
  display: flex;
  flex-wrap: wrap;
  margin-top: 22rpx;
}

.pet-chip {
  display: flex;
  height: 72rpx;
  align-items: center;
  margin: 0 16rpx 16rpx 0;
  padding: 0 24rpx 0 12rpx;
  border: 2rpx solid #f0e4dc;
  border-radius: 36rpx;
  background: #fffaf6;
}

.pet-chip.selected {
  border-color: #ff8c42;
  background: #fff0e5;
}

.chip-avatar {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: #f6efe9;
}

.chip-avatar-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
}

.chip-name {
  margin-left: 14rpx;
  color: #6f625a;
  font-size: 26rpx;
}

.pet-chip.selected .chip-name {
  color: #ff8c42;
  font-weight: 600;
}

.field-hint {
  margin-top: 6rpx;
  color: #aaa09a;
  font-size: 22rpx;
  text-align: right;
}

.block-hint {
  margin-top: 20rpx;
  line-height: 1.6;
  text-align: left;
}

/* ---------- 备注 ---------- */
.content-input {
  width: 100%;
  height: 200rpx;
  margin-top: 22rpx;
  padding: 22rpx;
  border-radius: 12rpx;
  background: #fffaf6;
  box-sizing: border-box;
  color: #3b332f;
  font-size: 27rpx;
}

.count-text {
  margin-top: 12rpx;
  color: #b1a7a1;
  font-size: 22rpx;
  text-align: right;
}

/* ---------- 提交 ---------- */
.submit-button {
  height: 92rpx;
  margin-top: 36rpx;
  border-radius: 12rpx;
  background: #ff8c42;
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 92rpx;
}

.submit-button[disabled] {
  background: #e5d8cf;
  color: #ffffff;
}

.submit-button::after {
  border: 0;
}
