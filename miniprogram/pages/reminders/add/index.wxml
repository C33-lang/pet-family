<view class="page" style="background-color: {{themeBg}};">
  <view class="form-card">
    <view class="section-title">提醒分类 <text class="required">*</text></view>
    <view class="type-grid">
      <view
        class="type-item {{selectedType === item.value ? 'selected' : ''}}"
        wx:for="{{types}}"
        wx:key="value"
        data-type="{{item.value}}"
        bindtap="handleTypeSelect"
      >
        <view class="type-icon">{{item.icon}}</view>
        <view class="type-label">{{item.label}}</view>
      </view>
    </view>
  </view>

  <view class="form-card">
    <view class="section-title">提醒名称</view>
    <input
      class="text-input"
      value="{{title}}"
      placeholder="留空默认使用分类名"
      maxlength="20"
      bindinput="handleTitleInput"
    />
    <view class="field-hint">{{title.length}}/20</view>
  </view>

  <view class="form-card">
    <view class="field-row">
      <text class="field-label">提醒周期</text>
      <picker
        mode="selector"
        range="{{cycleLabels}}"
        value="{{cycleIndex}}"
        bindchange="handleCycleChange"
      >
        <view class="picker-value">{{cycleLabels[cycleIndex]}} <text class="arrow">›</text></view>
      </picker>
    </view>

    <view class="field-row divided">
      <text class="field-label">下次日期</text>
      <picker
        mode="date"
        value="{{date}}"
        start="{{minDate}}"
        end="{{maxDate}}"
        bindchange="handleDateChange"
      >
        <view class="picker-value">{{date}} <text class="arrow">›</text></view>
      </picker>
    </view>

    <view class="field-row divided">
      <text class="field-label">提醒时机</text>
      <picker
        mode="selector"
        range="{{advanceLabels}}"
        value="{{advanceIndex}}"
        bindchange="handleAdvanceChange"
      >
        <view class="picker-value">{{advanceLabels[advanceIndex]}} <text class="arrow">›</text></view>
      </picker>
    </view>

    <view class="field-hint block-hint">「仅一次」完成后自动结束，其余周期会在打卡后按周期顺延</view>
  </view>

  <view class="form-card">
    <view class="section-title">关联宠物 <text class="required">*</text></view>
    <view class="pet-chips">
      <view
        class="pet-chip {{selectedMap[item._id] ? 'selected' : ''}}"
        wx:for="{{pets}}"
        wx:key="_id"
        data-id="{{item._id}}"
        bindtap="handlePetToggle"
      >
        <image
          wx:if="{{item.avatar}}"
          class="chip-avatar"
          src="{{item.avatar}}"
          mode="aspectFill"
        ></image>
        <view wx:else class="chip-avatar chip-avatar-placeholder">🐾</view>
        <text class="chip-name">{{item.name}}</text>
      </view>
    </view>
    <view wx:if="{{loadingPets}}" class="field-hint">正在加载宠物…</view>
    <view wx:else class="field-hint">多选表示这几只宠物共用一个提醒</view>
  </view>

  <view class="form-card">
    <view class="section-title">备注</view>
    <textarea
      class="content-input"
      value="{{remark}}"
      placeholder="例如：每年加强一针（选填）"
      maxlength="200"
      bindinput="handleRemarkInput"
    ></textarea>
    <view class="count-text">{{remark.length}}/200</view>
  </view>

  <button
    class="submit-button"
    disabled="{{!canSubmit || submitting}}"
    loading="{{submitting}}"
    bindtap="handleSubmit"
  >保存提醒</button>
</view>
