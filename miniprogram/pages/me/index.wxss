page {
  background: #fff8f2;
  color: #333333;
}

.page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 32rpx;
}

.user-card,
.stats-card,
.level-card,
.state-card {
  background: #ffffff;
  border-radius: 12rpx;
  box-shadow: 0 8rpx 24rpx rgba(122, 74, 36, 0.06);
}

.user-card {
  display: flex;
  align-items: center;
  padding: 32rpx;
  background: linear-gradient(135deg, #fff0e4 0%, #ffffff 100%);
}

.avatar {
  width: 112rpx;
  height: 112rpx;
  margin-right: 24rpx;
  border-radius: 50%;
  background: #ffe0c7;
}

.user-content {
  min-width: 0;
}

.nickname {
  overflow: hidden;
  color: #333333;
  font-size: 36rpx;
  font-weight: 600;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.user-caption,
.level-caption {
  margin-top: 10rpx;
  color: #999999;
  font-size: 24rpx;
}

.section-title {
  margin: 36rpx 4rpx 20rpx;
  color: #555555;
  font-size: 28rpx;
  font-weight: 600;
}

.stats-card {
  display: flex;
  padding: 28rpx 0;
}

.stat-item {
  flex: 1;
  text-align: center;
}

.stat-value {
  color: #ff8c42;
  font-size: 48rpx;
  font-weight: 600;
  line-height: 1.2;
}

.stat-label {
  margin-top: 8rpx;
  color: #777777;
  font-size: 24rpx;
}

.level-card {
  padding: 32rpx;
}

.level-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}

.level-title {
  color: #ff8c42;
  font-size: 40rpx;
  font-weight: 600;
}

.exp-text {
  color: #999999;
  font-size: 22rpx;
}

.progress-track {
  height: 12rpx;
  margin-top: 28rpx;
  overflow: hidden;
  border-radius: 12rpx;
  background: #fff0e4;
}

.progress-value {
  height: 100%;
  border-radius: 12rpx;
  background: #ff8c42;
}

.state-card {
  padding: 80rpx 40rpx;
  text-align: center;
}

.state-title {
  color: #444444;
  font-size: 32rpx;
  font-weight: 600;
}

.state-description {
  margin-top: 16rpx;
  color: #999999;
  font-size: 26rpx;
}

.retry-button {
  width: 240rpx;
  margin: 36rpx auto 0;
  border: none;
  border-radius: 12rpx;
  background: #ff8c42;
  color: #ffffff;
  font-size: 28rpx;
}

.retry-button::after {
  border: none;
}

.skeleton-card,
.skeleton-line {
  border-radius: 12rpx;
  background: linear-gradient(90deg, #fff0e4 25%, #fff8f2 37%, #fff0e4 63%);
  background-size: 400% 100%;
  animation: loading 1.4s ease infinite;
}

.skeleton-card {
  height: 176rpx;
}

.skeleton-card-small {
  height: 160rpx;
  margin-top: 32rpx;
}

.skeleton-line {
  width: 45%;
  height: 32rpx;
  margin: 36rpx 0 20rpx;
}

.skeleton-line-wide {
  width: 28%;
  margin-bottom: 0;
}

@keyframes loading {
  0% {
    background-position: 100% 0;
  }
  100% {
    background-position: 0 0;
  }
}


.avatar-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ffffff;
  font-size: 52rpx;
}


/* ---------- 背景颜色选择 ---------- */
.theme-card {
  background: #ffffff;
  border-radius: 28rpx;
  padding: 32rpx 28rpx;
  box-shadow: 0 8rpx 24rpx rgba(47, 42, 39, 0.05);
}

.theme-group-name {
  font-size: 24rpx;
  color: #9a938d;
  margin: 20rpx 0 12rpx;
}

.theme-group-name:first-child {
  margin-top: 0;
}

.theme-swatches {
  display: flex;
  flex-wrap: wrap;
}

.theme-swatch {
  width: 80rpx;
  height: 80rpx;
  margin: 0 20rpx 20rpx 0;
  border-radius: 50%;
  border: 2rpx solid rgba(47, 42, 39, 0.08);
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.theme-swatch:nth-child(6n) {
  margin-right: 0;
}

.theme-swatch.active {
  border: 4rpx solid #ff8c42;
}

.swatch-check {
  font-size: 32rpx;
  color: #ff8c42;
  font-weight: 600;
}

.custom-panel {
  padding: 24rpx;
  background: #fbf9f7;
  border-radius: 20rpx;
}

.custom-preview-row {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.custom-preview {
  width: 96rpx;
  height: 96rpx;
  border-radius: 20rpx;
  border: 2rpx solid rgba(47, 42, 39, 0.08);
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.custom-preview.active {
  border: 4rpx solid #ff8c42;
}

.custom-preview-info {
  margin-left: 20rpx;
}

.custom-preview-title {
  font-size: 26rpx;
  color: #2f2a27;
}

.custom-preview-hex {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #9a938d;
}

.custom-row {
  display: flex;
  align-items: center;
  margin-top: 12rpx;
}

.custom-label {
  width: 72rpx;
  font-size: 24rpx;
  color: #6f6862;
}

.custom-slider {
  flex: 1;
  margin: 0;
}

.light-options {
  flex: 1;
  display: flex;
}

.light-option {
  flex: 1;
  margin-right: 16rpx;
  padding: 12rpx 0;
  text-align: center;
  font-size: 24rpx;
  color: #6f6862;
  background: #ffffff;
  border-radius: 12rpx;
  border: 2rpx solid rgba(47, 42, 39, 0.08);
}

.light-option:last-child {
  margin-right: 0;
}

.light-option.active {
  color: #ff8c42;
  border-color: #ff8c42;
  background: #fff6ef;
}

.theme-hint {
  margin-top: 24rpx;
  font-size: 24rpx;
  color: #9a938d;
  text-align: center;
}

/* ---------- 家庭成员 ---------- */
.family-card {
  background: #ffffff;
  border-radius: 28rpx;
  padding: 32rpx 28rpx;
  box-shadow: 0 8rpx 24rpx rgba(47, 42, 39, 0.05);
}

.family-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.family-name {
  font-size: 30rpx;
  font-weight: 500;
  color: #2f2a27;
}

.family-caption {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #9a938d;
}

.family-count {
  padding: 8rpx 20rpx;
  border-radius: 24rpx;
  background: #fff3e9;
  font-size: 26rpx;
  color: #ff8c42;
}

.invite-box {
  margin-top: 28rpx;
  padding: 28rpx 24rpx;
  background: #fffaf5;
  border: 2rpx dashed #f2d9c3;
  border-radius: 20rpx;
}

.invite-label {
  font-size: 23rpx;
  color: #a89a8d;
}

.invite-code {
  margin-top: 10rpx;
  font-size: 46rpx;
  font-weight: 500;
  letter-spacing: 10rpx;
  color: #2f2a27;
}

.invite-actions {
  display: flex;
  align-items: center;
  margin-top: 22rpx;
}

.invite-button {
  min-width: 140rpx;
  height: 62rpx;
  line-height: 62rpx;
  margin: 0;
  padding: 0 28rpx;
  border: 2rpx solid #ffd7b8;
  border-radius: 31rpx;
  background: #ffffff;
  font-size: 25rpx;
  color: #ff8c42;
  text-align: center;
}

.invite-button::after {
  border: none;
}

.invite-share {
  margin-left: 20rpx;
  background: #ff8c42;
  border-color: #ff8c42;
  color: #ffffff;
}

.family-hint {
  margin-top: 22rpx;
  font-size: 22rpx;
  line-height: 1.6;
  color: #a9a09a;
}

.family-links {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 28rpx;
  padding-top: 24rpx;
  border-top: 2rpx solid #f2eeea;
}

.family-link {
  font-size: 26rpx;
  color: #6b625c;
}

.family-link-danger {
  color: #d4534f;
}

.family-retry {
  margin-top: 24rpx;
}
