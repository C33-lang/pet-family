<view class="page" style="background-color: {{themeBg}};">
  <view wx:if="{{status === 'loading'}}" class="skeleton" aria-label="正在加载">
    <view class="skeleton-card"></view>
    <view class="skeleton-line skeleton-line-wide"></view>
    <view class="skeleton-line"></view>
    <view class="skeleton-card skeleton-card-small"></view>
  </view>

  <view wx:elif="{{status === 'error'}}" class="state-card">
    <view class="state-title">加载失败</view>
    <view class="state-description">{{errorMessage}}</view>
    <button class="retry-button" bindtap="loadData" loading="{{retrying}}">重新加载</button>
  </view>

  <block wx:else>
    <view class="user-card">
      <view wx:if="{{!userInfo.avatarUrl}}" class="avatar avatar-placeholder">🐾</view>
      <image wx:else class="avatar" src="{{userInfo.avatarUrl}}" mode="aspectFill"></image>
      <view class="user-content">
        <view class="nickname">{{userInfo.nickName}}</view>
        <view class="user-caption">记录每一份陪伴，见证一起成长</view>
      </view>
    </view>

    <view class="section-title">我的数据</view>
    <view class="stats-card">
      <view class="stat-item" bindtap="handlePetsTap">
        <view class="stat-value">{{petCount}}</view>
        <view class="stat-label">宠物数量</view>
      </view>
    </view>

    <view class="section-title">家庭成员</view>
    <view class="family-card">
      <block wx:if="{{family}}">
        <view class="family-head">
          <view>
            <view class="family-name">我的家</view>
            <view class="family-caption">{{family.role === 'owner' ? '你是创建者' : '你是家庭成员'}}</view>
          </view>
          <view class="family-count">{{family.memberCount}} 人</view>
        </view>

        <view class="invite-box">
          <view class="invite-label">邀请码</view>
          <view class="invite-code">{{family.inviteCode}}</view>
          <view class="invite-actions">
            <view class="invite-button" bindtap="handleCopyInvite">复制</view>
            <button class="invite-button invite-share" open-type="share">邀请家人</button>
          </view>
        </view>
        <view class="family-hint">邀请码 24 小时内有效，家人输入后即可看到同一份宠物数据</view>

        <view class="family-links">
          <view class="family-link" bindtap="handleJoinTap">加入家人的家庭</view>
          <view class="family-link family-link-danger" bindtap="handleLeaveTap">退出家庭</view>
        </view>
      </block>

      <block wx:else>
        <view class="family-name">家庭信息加载失败</view>
        <view class="family-caption">{{familyError || '请检查网络后重试'}}</view>
        <button class="retry-button family-retry" bindtap="loadFamily">重新加载</button>
      </block>
    </view>

    <view class="section-title">背景颜色</view>
    <view class="theme-card">
      <block wx:for="{{themeGroups}}" wx:key="name" wx:for-item="group">
        <view class="theme-group-name">{{group.name}}</view>
        <view class="theme-swatches">
          <view
            wx:for="{{group.themes}}"
            wx:key="key"
            wx:for-item="option"
            class="theme-swatch {{option.key === themeKey ? 'active' : ''}}"
            style="background-color: {{option.color}};"
            data-key="{{option.key}}"
            bindtap="handleThemeTap"
          >
            <text wx:if="{{option.key === themeKey}}" class="swatch-check">✓</text>
          </view>
        </view>
      </block>

      <view class="theme-group-name">自定义</view>
      <view class="custom-panel">
        <view class="custom-preview-row">
          <view
            class="custom-preview {{themeKey === 'custom' ? 'active' : ''}}"
            style="background-color: {{customColor}};"
          >
            <text wx:if="{{themeKey === 'custom'}}" class="swatch-check">✓</text>
          </view>
          <view class="custom-preview-info">
            <view class="custom-preview-title">{{themeKey === 'custom' ? '使用中' : '拖动色相条后自动应用'}}</view>
            <view class="custom-preview-hex">{{customColor}}</view>
          </view>
        </view>

        <view class="custom-row">
          <text class="custom-label">色相</text>
          <slider
            class="custom-slider"
            min="0"
            max="360"
            value="{{hue}}"
            activeColor="#FF8C42"
            backgroundColor="#E8E2DC"
            block-size="20"
            bindchanging="handleHueChanging"
            bindchange="handleHueChange"
          />
        </view>

        <view class="custom-row">
          <text class="custom-label">明度</text>
          <view class="light-options">
            <view
              wx:for="{{lightOptions}}"
              wx:key="name"
              class="light-option {{index === lightIndex ? 'active' : ''}}"
              data-index="{{index}}"
              bindtap="handleLightTap"
            >{{item.name}}</view>
          </view>
        </view>
      </view>

      <view class="theme-hint">当前：{{themeName}}</view>
    </view>
  </block>
</view>
