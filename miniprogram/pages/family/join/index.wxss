page {
  min-height: 100%;
}

.page {
  min-height: 100vh;
  padding: 32rpx 28rpx 60rpx;
  box-sizing: border-box;
}

.card {
  background: #ffffff;
  border-radius: 28rpx;
  padding: 44rpx 36rpx;
  box-shadow: 0 8rpx 24rpx rgba(47, 42, 39, 0.05);
}

.title {
  font-size: 36rpx;
  font-weight: 500;
  color: #2f2a27;
}

.desc {
  margin-top: 16rpx;
  font-size: 26rpx;
  line-height: 1.6;
  color: #8b827b;
}

.code-input {
  margin-top: 48rpx;
  height: 108rpx;
  padding: 0 32rpx;
  background: #faf7f4;
  border: 2rpx solid #ece5df;
  border-radius: 20rpx;
  font-size: 44rpx;
  font-weight: 500;
  letter-spacing: 8rpx;
  color: #2f2a27;
  text-align: center;
}

.code-placeholder {
  font-size: 28rpx;
  font-weight: 400;
  letter-spacing: 0;
  color: #c3bab3;
}

.error-text {
  margin-top: 20rpx;
  font-size: 25rpx;
  line-height: 1.5;
  color: #d4534f;
}

.primary-button {
  margin-top: 48rpx;
  height: 92rpx;
  line-height: 92rpx;
  border-radius: 46rpx;
  background: #ff8c42;
  color: #ffffff;
  font-size: 30rpx;
  border: none;
}

.primary-button[disabled] {
  background: #f0dccb;
  color: #ffffff;
}

.tip {
  margin-top: 32rpx;
  font-size: 23rpx;
  line-height: 1.6;
  color: #a9a09a;
  text-align: center;
}
