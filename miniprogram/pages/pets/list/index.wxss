page {
  background: #fffaf6;
  color: #2f2a27;
}

.page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 28rpx 28rpx 180rpx;
}

.pet-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.pet-card {
  position: relative;
  display: flex;
  align-items: center;
  min-height: 144rpx;
  padding: 24rpx;
  border: 1rpx solid #f4e4d8;
  border-radius: 12rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 28rpx rgba(109, 76, 54, 0.08);
}

.pet-avatar,
.avatar-placeholder {
  width: 104rpx;
  height: 104rpx;
  flex: none;
  border-radius: 50%;
  background: #fff0e6;
}

.avatar-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
}

.pet-info {
  margin-left: 24rpx;
}

.pet-name {
  max-width: 360rpx;
  overflow: hidden;
  color: #2f2a27;
  font-size: 34rpx;
  font-weight: 600;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.pet-age {
  margin-top: 10rpx;
  color: #8c817a;
  font-size: 26rpx;
}

/* ---------- 提醒角标：逾期红 / 今天橙 / 7 天内浅橙 / 其余灰 ---------- */
.pet-reminder {
  overflow: hidden;
  max-width: 400rpx;
  margin-top: 10rpx;
  font-size: 23rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.pet-reminder.level-overdue {
  color: #e64340;
}

.pet-reminder.level-today {
  color: #ff8c42;
}

.pet-reminder.level-soon {
  color: #d98b3f;
}

.pet-reminder.level-normal {
  color: #a9a09a;
}

.level-badge {
  position: absolute;
  top: 18rpx;
  right: 24rpx;
  padding: 5rpx 14rpx;
  border-radius: 999rpx;
  background: #fff0e6;
  color: #ff8c42;
  font-size: 22rpx;
  font-weight: 600;
}

.card-arrow {
  position: absolute;
  right: 26rpx;
  bottom: 22rpx;
  color: #c5bbb4;
  font-size: 42rpx;
  line-height: 1;
}

.state-box {
  display: flex;
  min-height: 70vh;
  align-items: center;
  flex-direction: column;
  justify-content: center;
  text-align: center;
}

.state-illustration {
  font-size: 112rpx;
}

.pet-illustration {
  position: relative;
  width: 260rpx;
  height: 190rpx;
}

.pet-face {
  position: absolute;
  left: 20rpx;
  bottom: 0;
  font-size: 130rpx;
}

.pet-face-small {
  right: 10rpx;
  left: auto;
  bottom: 10rpx;
  font-size: 104rpx;
}

.state-title {
  margin-top: 28rpx;
  color: #6f625a;
  font-size: 28rpx;
}

.state-action {
  width: 240rpx;
  margin-top: 32rpx;
  border: 0;
  border-radius: 12rpx;
  background: #ff8c42;
  color: #ffffff;
  font-size: 28rpx;
}

.state-action::after,
.primary-button::after {
  border: 0;
}

.bottom-bar {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 10;
  padding: 20rpx 28rpx calc(20rpx + env(safe-area-inset-bottom));
  background: rgba(255, 250, 246, 0.96);
}

.primary-button {
  height: 88rpx;
  border: 0;
  border-radius: 12rpx;
  background: #ff8c42;
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 600;
  line-height: 88rpx;
}

.skeleton-card {
  box-shadow: none;
}

.skeleton {
  overflow: hidden;
  border-radius: 8rpx;
  background: linear-gradient(90deg, #f3ece7 25%, #faf6f3 37%, #f3ece7 63%);
  background-size: 400% 100%;
  animation: shimmer 1.4s ease infinite;
}

.avatar-skeleton {
  width: 104rpx;
  height: 104rpx;
  border-radius: 50%;
}

.skeleton-content {
  flex: 1;
  margin-left: 24rpx;
}

.skeleton-title {
  width: 45%;
  height: 34rpx;
}

.skeleton-line {
  width: 65%;
  height: 24rpx;
  margin-top: 20rpx;
}

@keyframes shimmer {
  0% {
    background-position: 100% 0;
  }
  100% {
    background-position: 0 0;
  }
}

/* ---------- 搜索栏（宠物数量较多时显示） ---------- */
.search-bar {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
  padding: 0 24rpx;
  height: 80rpx;
  background: #ffffff;
  border-radius: 40rpx;
  box-shadow: 0 4rpx 16rpx rgba(47, 42, 39, 0.05);
}

.search-icon {
  font-size: 26rpx;
  margin-right: 12rpx;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  color: #2f2a27;
}

.search-placeholder {
  color: #b8b0aa;
}

.search-clear {
  padding: 8rpx 12rpx;
  font-size: 26rpx;
  color: #b8b0aa;
}

.search-empty {
  padding-top: 120rpx;
}
